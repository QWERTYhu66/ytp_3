---
import fetchedData from '../data/trending_fetched.json';

type Copy = {
  kicker: string;
  title: string;
  subtitle: string;
  updatedLabel: string;
  redditTitle: string;
  redditBrowse: string;
  youtubeTitle: string;
  youtubeOpen: string;
  hashtagTitle: string;
  instagramPlatform: string;
  tiktokPlatform: string;
  trendsTitle: string;
  trendsOpen: string;
  sourcesTitle: string;
  sourceNote: string;
  upvotesLabel: string;
  commentsLabel: string;
  daysAgoLabel: string;
  viewsLabel: string;
  subredditLabel: string;
  noDataLabel: string;
};

type StaticYT    = { query: string; theme: string; url: string };
type StaticTag   = { label: string; theme: string; url: string };
type StaticSub   = { label: string; theme: string; url: string };
type StaticTrend = { query: string; theme: string; url: string };
type Source      = { label: string; url: string };

type FetchedVideo = {
  title: string; channelTitle: string; url: string;
  views: number; viewsFormatted: string;
  publishedAt: string; query: string; theme: string;
};
type FetchedPost = {
  title: string; url: string; subreddit: string;
  upvotes: number; comments: number; daysAgo: number; flair: string | null;
};

interface Props {
  lang: string;
  copy: Copy;
  updated: string;
  youtube: StaticYT[];
  instagram: StaticTag[];
  tiktok: StaticTag[];
  reddit: StaticSub[];
  googleTrends: StaticTrend[];
  sources: Source[];
}

const { lang, copy, updated, youtube, instagram, tiktok, reddit, googleTrends, sources } = Astro.props;

// Fetched data — use if available, fall back to static
const liveReddit: FetchedPost[]  = (fetchedData as any).reddit ?? [];
const liveYT: FetchedVideo[]     = ((fetchedData as any).youtube?.[lang] ?? []);
const fetchedAt: string | null   = (fetchedData as any).fetchedAt ?? null;

const displayDate = fetchedAt
  ? new Date(fetchedAt).toLocaleDateString('en-CA') // YYYY-MM-DD
  : updated;

const hasLiveReddit = liveReddit.length > 0;
const hasLiveYT     = liveYT.length > 0;

// Personalised hashtag panel data is handled client-side (see <script> below)
---

<main class="tr-page">

  <!-- ── Hero ── -->
  <section class="tr-hero">
    <div class="tr-hero-inner">
      <div class="tr-kicker">
        <span class="material-symbols-outlined">local_fire_department</span>
        {copy.kicker}
      </div>
      <h1>{copy.title}</h1>
      <p class="tr-subtitle">{copy.subtitle}</p>
      <div class="tr-updated">
        <span class="material-symbols-outlined">update</span>
        {copy.updatedLabel} {displayDate}
      </div>
    </div>
  </section>

  <!-- ── Personalised hashtag panel (client-side) ── -->
  <section class="tr-pref-panel" id="prefHashtags" style="display:none">
    <div class="tr-pref-inner">
      <div class="tr-pref-header">
        <span class="material-symbols-outlined">auto_awesome</span>
        <span id="prefHtLabel">Picked for your interests</span>
      </div>
      <div id="prefHtGrid" class="tr-pref-grid"></div>
    </div>
  </section>

  <div class="tr-body">

    <!-- ── Reddit ── -->
    <section class="tr-section">
      <div class="tr-section-head">
        <div class="tr-platform-pill tr-pill-reddit">
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path fill="#fff" d="M16.67 10a1.46 1.46 0 0 0-2.47-1 7.12 7.12 0 0 0-3.85-1.23l.65-3.08 2.13.45a1 1 0 1 0 .1-.49l-2.38-.5a.25.25 0 0 0-.29.19l-.73 3.44a7.14 7.14 0 0 0-3.89 1.23 1.46 1.46 0 1 0-1.61 2.39 2.87 2.87 0 0 0 0 .44c0 2.24 2.61 4.06 5.83 4.06s5.83-1.82 5.83-4.06a2.87 2.87 0 0 0 0-.44 1.46 1.46 0 0 0 .68-1.4zM7.27 11a1 1 0 1 1 1 1 1 1 0 0 1-1-1zm5.58 2.65a3.56 3.56 0 0 1-2.85.6 3.56 3.56 0 0 1-2.85-.6.19.19 0 0 1 .27-.27 3.2 3.2 0 0 0 2.58.47 3.2 3.2 0 0 0 2.58-.47.19.19 0 0 1 .27.27zm-.17-1.65a1 1 0 1 1 1-1 1 1 0 0 1-1 1z"/></svg>
          Reddit
        </div>
        <h2>{copy.redditTitle}</h2>
      </div>

      {hasLiveReddit ? (
        <div class="tr-reddit-grid">
          {liveReddit.map((post) => (
            <a href={post.url} target="_blank" rel="noopener" class="tr-reddit-card">
              <div class="tr-reddit-meta">
                <span class="tr-subreddit-pill">r/{post.subreddit}</span>
                {post.flair && <span class="tr-flair">{post.flair}</span>}
                <span class="tr-days-ago">{post.daysAgo}{copy.daysAgoLabel}</span>
              </div>
              <p class="tr-reddit-title">{post.title}</p>
              <div class="tr-reddit-stats">
                <span>↑ {post.upvotes.toLocaleString()} {copy.upvotesLabel}</span>
                <span>💬 {post.comments} {copy.commentsLabel}</span>
                <span class="tr-open-link">{copy.redditBrowse} →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="tr-static-list">
          {reddit.map((sub) => (
            <a href={sub.url} target="_blank" rel="noopener" class="tr-static-row">
              <span class="tr-theme-tag">{sub.theme}</span>
              <span class="tr-static-label">{sub.label}</span>
              <span class="tr-open-arrow">→</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- ── YouTube ── -->
    <section class="tr-section">
      <div class="tr-section-head">
        <div class="tr-platform-pill tr-pill-yt">
          <span class="material-symbols-outlined" style="font-size:14px">play_circle</span>
          YouTube
        </div>
        <h2>{copy.youtubeTitle}</h2>
      </div>

      {hasLiveYT ? (
        <div class="tr-yt-grid">
          {liveYT.map((video) => (
            <a href={video.url} target="_blank" rel="noopener" class="tr-yt-card">
              <div class="tr-yt-card-top">
                <span class="tr-theme-tag">{video.theme}</span>
                {video.views > 0 && (
                  <span class="tr-views">{video.viewsFormatted} {copy.viewsLabel}</span>
                )}
              </div>
              <p class="tr-yt-title">{video.title}</p>
              <div class="tr-yt-meta">
                <span class="tr-channel">{video.channelTitle}</span>
                <span class="tr-open-link">{copy.youtubeOpen} →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="tr-yt-grid">
          {youtube.map((video) => (
            <a href={video.url} target="_blank" rel="noopener" class="tr-yt-card tr-yt-card--static">
              <div class="tr-yt-card-top">
                <span class="tr-theme-tag">{video.theme}</span>
              </div>
              <p class="tr-yt-title">{video.query}</p>
              <span class="tr-open-link">{copy.youtubeOpen} →</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- ── Hashtags: Instagram + TikTok ── -->
    <section class="tr-section">
      <div class="tr-section-head">
        <h2>{copy.hashtagTitle}</h2>
      </div>
      <div class="tr-hashtag-cols">
        <div class="tr-hashtag-col">
          <div class="tr-platform-pill tr-pill-insta">
            <span>📸</span> {copy.instagramPlatform}
          </div>
          <div class="tr-chips">
            {instagram.map((tag) => (
              <a href={tag.url} target="_blank" rel="noopener" class="tr-chip tr-chip--insta">
                {tag.label}
              </a>
            ))}
          </div>
        </div>
        <div class="tr-hashtag-col">
          <div class="tr-platform-pill tr-pill-tiktok">
            <span>🎵</span> {copy.tiktokPlatform}
          </div>
          <div class="tr-chips">
            {tiktok.map((tag) => (
              <a href={tag.url} target="_blank" rel="noopener" class="tr-chip tr-chip--tiktok">
                {tag.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Google Trends ── -->
    <section class="tr-section">
      <div class="tr-section-head">
        <div class="tr-platform-pill tr-pill-trends">
          <span class="material-symbols-outlined" style="font-size:14px">trending_up</span>
          Google Trends
        </div>
        <h2>{copy.trendsTitle}</h2>
      </div>
      <div class="tr-trends-list">
        {googleTrends.map((trend, i) => (
          <a href={trend.url} target="_blank" rel="noopener" class="tr-trend-row">
            <span class="tr-trend-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="tr-trend-query">{trend.query}</span>
            <span class="tr-trend-theme">{trend.theme}</span>
            <span class="material-symbols-outlined tr-trend-arrow">open_in_new</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Sources ── -->
    <footer class="tr-sources">
      <h3>{copy.sourcesTitle}</h3>
      <p>{copy.sourceNote}</p>
      <div class="tr-source-links">
        {sources.map((s) => (
          <a href={s.url} target="_blank" rel="noopener">
            {s.label}
            <span class="material-symbols-outlined">open_in_new</span>
          </a>
        ))}
      </div>
    </footer>

  </div>
</main>

<!-- ── Personalised panel (reads localStorage) ── -->
