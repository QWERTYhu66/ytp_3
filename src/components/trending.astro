    night:   {en:'Night scene',zh:'夜生活',jp:'夜遊び',kr:'야경'},
  };
  const PANEL_LABELS = {en:'Picked for your interests',zh:'根據你的偏好推薦',jp:'あなたの好みに合わせて',kr:'취향에 맞게 선택됨'};

  const htmlLang = document.documentElement.lang;
  const lang = htmlLang==='zh-TW'?'zh':htmlLang==='ja'?'jp':htmlLang==='ko'?'kr':'en';
  let prefs;
  try { prefs = JSON.parse(localStorage.getItem('ytp_prefs')||'null'); } catch {}
  if (!prefs||!prefs.interests||!prefs.interests.length) return;

  const panel = document.getElementById('prefHashtags');
  const grid  = document.getElementById('prefHtGrid');
  const label = document.getElementById('prefHtLabel');
  if (!panel||!grid||!label) return;
  label.textContent = PANEL_LABELS[lang]||PANEL_LABELS.en;

  let html = '';
  for (const interest of prefs.interests) {
    const bucket = HASHTAGS[interest]?.[lang]||HASHTAGS[interest]?.en||[];
    if (!bucket.length) continue;
    const iLabel = INTEREST_LABELS[interest]?.[lang]||interest;
    html += `<div class="tr-pref-section"><div class="tr-pref-section-title">${iLabel}</div><div class="tr-pref-chips">`;
    for (const t of bucket) {
      const icon = PLATFORM_ICONS[t.platform]||'🔗';
      html += `<a href="${t.url}" target="_blank" rel="noopener" class="tr-pref-chip tr-pref-chip--${t.platform.toLowerCase().replace(/\s/g,'-')}"><span>${icon}</span><span>${t.label}</span><span class="tr-pref-plat">${t.platform}</span></a>`;
    }
    html += '</div></div>';
  }
  grid.innerHTML = html;
  panel.style.display = '';
})();
</script>

