---
import { getHotelsForLang } from '../lib/hotelData';

type Copy = {
  kicker: string;
  h1: string;
  body: string;
  check: string;
  browse: string;
  registeredHotels: string;
  districtsCovered: string;
  roomsListed: string;
  sectionLabel: string;
  sectionTitle: string;
  searchPlaceholder: string;
  searchAria: string;
  filterAria: string;
  all: string;
  showing: string;
  featuredHotels: string;
  featuredHotel: string;
  registered: string;
  mrtVaries: string;
  rooms: string;
  viewDetails: string;
  from: string;
  priceVaries: string;
  mapAria: string;
  starRated?: string;
  officialSource?: string;
  priceFilterLabel?: string;
  starFilterLabel?: string;
  priceAll?: string;
  priceBudget?: string;
  priceMid?: string;
  pricePremium?: string;
  priceUnknown?: string;
  starAll?: string;
  starRatedOnly?: string;
  starThreePlus?: string;
  starFourPlus?: string;
  starFivePlus?: string;
  dataPromptTitle?: string;
  dataPromptBody?: string;
  dataPromptZh?: string;
  dataPromptEn?: string;
  showMore?: string;
  showLess?: string;
};

interface Props {
  copy: Copy;
  basePath?: string;
  lang?: 'en' | 'zh' | 'jp' | 'kr';
}

const { copy, basePath = '', lang = 'zh' } = Astro.props;
const hotelList = getHotelsForLang(lang);

// Pick the localised district for each hotel
const getDistrict = (h: typeof hotelList[0]) => {
  if (lang === 'en') return h.district_en || h.district;
  if (lang === 'jp') return h.district_jp || h.district;
  if (lang === 'kr') return h.district_kr || h.district;
  return h.district; // zh — keep original Chinese
};
const hasLatin = (value: string) => /[A-Za-z]/.test(value || '');
const legalNo = (value: string) => String(value || '').match(/(\d+)/)?.[1] || '';
const getDisplayName = (h: typeof hotelList[0]) => {
  if (lang !== 'en') return h.name;
  if (hasLatin(h.name)) return h.name;
  const id = legalNo(h.legal_id);
  return id ? `Taipei Legal Hotel #${id}` : 'Taipei Legal Hotel';
};

const totalHotels = hotelList.length;
const districtCount = new Set(hotelList.map(getDistrict)).size;
const roomCount = hotelList.reduce((sum, hotel) => sum + (hotel.rooms || 0), 0);
const browsableHotels = [...hotelList].sort((a, b) => {
  const starDiff = (b.official_star_rating || 0) - (a.official_star_rating || 0);
  if (starDiff) return starDiff;
  const roomDiff = (b.rooms || 0) - (a.rooms || 0);
  if (roomDiff) return roomDiff;
  return getDisplayName(a).localeCompare(getDisplayName(b));
});
const districts = Array.from(new Set(hotelList.map(getDistrict))).sort((a, b) => a.localeCompare(b));

const formatPrice = (low: number | null, high: number | null) => {
  const fmt = (value: number) => `NT$${value.toLocaleString()}`;
  if (low && high) return `${fmt(low)} - ${fmt(high)}`;
  if (low) return copy.from ? `${copy.from} ${fmt(low)}` : fmt(low);
  return copy.priceVaries;
};
const getPriceLow = (h: typeof hotelList[0]) => h.lowest_price;
const getPriceHigh = (h: typeof hotelList[0]) => h.highest_price;
const getStars = (h: typeof hotelList[0]) => h.official_star_rating;
const showDataLanguagePrompt = lang === 'jp' || lang === 'kr';
const hasPrice = (h: typeof hotelList[0]) => Number.isFinite(getPriceLow(h) ?? NaN) || Number.isFinite(getPriceHigh(h) ?? NaN);
---

<main class="hotels-page">
  <section class="hotels-hero">
    <div class="hotels-hero-inner">
      <div class="hotels-copy">
        <div class="hotel-kicker">
          <span class="material-symbols-outlined">hotel</span>
          {copy.kicker}
        </div>
        <h1>{copy.h1}</h1>
        <p>{copy.body}</p>
        {showDataLanguagePrompt && (
          <div class="hotel-data-prompt">
            <div>
              <strong>{copy.dataPromptTitle}</strong>
              <span>{copy.dataPromptBody}</span>
            </div>
            <div class="hotel-data-actions">
              <a href="/zh/hotels">{copy.dataPromptZh}</a>
              <a href="/hotels">{copy.dataPromptEn}</a>
            </div>
          </div>
        )}
        <div class="hotel-actions">
          <a href={`${basePath}/hotel-check`} class="hotel-primary">
            <span class="material-symbols-outlined">manage_search</span>
            {copy.check}
          </a>
          <a href="#hotel-browser" class="hotel-secondary">
            <span class="material-symbols-outlined">travel_explore</span>
            {copy.browse}
          </a>
        </div>
      </div>

      <div class="stay-panel" aria-label={copy.mapAria}>
        <div class="stay-map">
          <span class="station station-main">Taipei Main</span>
          <span class="station station-east">Xinyi</span>
          <span class="station station-north">Shilin</span>
          <span class="station station-west">Ximen</span>
          <span class="map-line map-red"></span>
          <span class="map-line map-blue"></span>
        </div>
        <div class="stay-stats">
          <div>
            <strong>{totalHotels.toLocaleString()}</strong>
            <span>{copy.registeredHotels}</span>
          </div>
          <div>
            <strong>{districtCount}</strong>
            <span>{copy.districtsCovered}</span>
          </div>
          <div>
            <strong>{roomCount.toLocaleString()}</strong>
            <span>{copy.roomsListed}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hotel-browser" id="hotel-browser">
    <div class="browser-head">
      <div>
        <div class="section-label">{copy.sectionLabel}</div>
        <h2>{copy.sectionTitle}</h2>
      </div>
      <div class="hotel-search">
        <span class="material-symbols-outlined">search</span>
        <input id="hotel-search-input" type="search" placeholder={copy.searchPlaceholder} aria-label={copy.searchAria} />
      </div>
    </div>

    <div class="hotel-filter-panel">
      <div class="district-filter" aria-label={copy.filterAria}>
        <button class="district-chip is-active" type="button" data-district="all">{copy.all}</button>
        {districts.map((district) => (
          <button class="district-chip" type="button" data-district={district}>{lang === 'zh' ? district.replace('區', '') : district}</button>
        ))}
      </div>
      <div class="hotel-select-filters">
        <label>
          <span>{copy.priceFilterLabel || 'Price'}</span>
          <select id="hotel-price-filter">
            <option value="all">{copy.priceAll || 'Any price'}</option>
            <option value="budget">{copy.priceBudget || 'Under NT$3,000'}</option>
            <option value="mid">{copy.priceMid || 'NT$3,000-8,000'}</option>
            <option value="premium">{copy.pricePremium || 'NT$8,000+'}</option>
            <option value="unknown">{copy.priceUnknown || 'Price varies'}</option>
          </select>
        </label>
      </div>
    </div>

    <div id="hotel-count" class="hotel-count">{copy.showing} {browsableHotels.length} {copy.featuredHotels}</div>

    <div class="hotel-grid" id="hotel-grid">
      {browsableHotels.map((hotel) => (
        <article
          class="stay-card"
          data-district={getDistrict(hotel)}
          data-search={`${hotel.name} ${hotel.name_zh} ${hotel.name_en} ${hotel.address} ${hotel.address_zh} ${hotel.address_en} ${hotel.location} ${hotel.closest_mrt} ${getDistrict(hotel)}`}
          data-price-low={getPriceLow(hotel) ?? ''}
          data-price-high={getPriceHigh(hotel) ?? ''}
          data-price-known={hasPrice(hotel) ? 'true' : 'false'}
        >
          <a href={`${basePath}/hotel/${hotel.id}`} class="stay-card-link">
            <div class="stay-card-top">
              <span class="stay-icon material-symbols-outlined">apartment</span>
            </div>
            <h3>{getDisplayName(hotel)}</h3>
            {lang === 'en' && !hasLatin(hotel.name) && (
              <p style="margin:-0.2rem 0 0.45rem;font-size:0.73rem;color:#7b7164">Official name: {hotel.name}</p>
            )}
            <p>{hotel.address}</p>
            <div class="stay-meta">
              <span><span class="material-symbols-outlined">subway</span>{hotel.closest_mrt || copy.mrtVaries}</span>
              <span><span class="material-symbols-outlined">location_on</span>{getDistrict(hotel)}</span>
              {hotel.rooms && <span><span class="material-symbols-outlined">bed</span>{hotel.rooms} {copy.rooms}</span>}
            </div>
            <div class="stay-card-bottom">
              <div>
                <strong>{formatPrice(getPriceLow(hotel), getPriceHigh(hotel))}</strong>
                {hotel.official_star_source && <em>{copy.officialSource}</em>}
              </div>
              <span>{copy.viewDetails}</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="hotel-pagination-row" id="hotelPaginationRow" style="display:none">
      <button class="hotel-page-btn" id="hotelPrevBtn" disabled>&#8249;</button>
      <span class="hotel-page-info" id="hotelPageInfo"></span>
      <button class="hotel-page-btn" id="hotelNextBtn">&#8250;</button>
    </div>
  </section>
</main>

