  .stay-card.is-hidden { display: none; }
  .stay-card-link { height: 100%; display: flex; flex-direction: column; background: #fff; color: inherit; border: 1px solid rgba(22,59,70,0.13); border-radius: 8px; padding: 1rem; text-decoration: none; box-shadow: 0 12px 30px rgba(22,59,70,0.07); transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease; }
  .stay-card-link:hover { transform: translateY(-3px); border-color: rgba(46,109,164,0.42); box-shadow: 0 16px 34px rgba(22,59,70,0.12); }
  .stay-card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.9rem; }
  .stay-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 8px; background: #eaf3f6; color: #2e6da4; }
  .verified-pill { display: inline-flex; align-items: center; gap: 0.2rem; color: #1e6b52; background: #edf8f1; border-radius: 999px; padding: 0.26rem 0.5rem; font-size: 0.72rem; font-weight: 900; }
  .verified-pill .material-symbols-outlined { font-size: 14px; }
  .stay-card h3 { font-size: 1rem; line-height: 1.28; margin: 0 0 0.45rem; color: #163b46; }
  .stay-card p { color: #62584c; font-size: 0.84rem; line-height: 1.55; margin-bottom: 0.75rem; }
  .stay-meta { display: grid; gap: 0.35rem; color: #506065; font-size: 0.78rem; }
  .stay-meta span { display: flex; align-items: center; gap: 0.3rem; min-width: 0; }
  .stay-meta .material-symbols-outlined { color: #2e6da4; font-size: 15px; flex: 0 0 auto; }
  .stay-card-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.75rem; border-top: 1px solid rgba(22,59,70,0.1); padding-top: 0.8rem; margin-top: auto; }
  .stay-card-bottom strong { display: block; color: #b8422e; font-size: 0.9rem; }
  .stay-card-bottom em { display: block; margin-top: 0.15rem; color: #7b7164; font-size: 0.68rem; font-style: normal; line-height: 1.25; }
  .stay-card-bottom span { color: #2e6da4; font-size: 0.78rem; font-weight: 900; white-space: nowrap; }
  /* ── Tablet (≤1024px) ── */
  @media (max-width: 1024px) {
    .hotel-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hotels-hero-inner { gap: 2rem; }
    .hotel-select-filters label { min-width: 140px; }
  }
  /* ── Narrow tablet (≤980px) ── */
  @media (max-width: 980px) {
    .hotels-hero-inner { grid-template-columns: 1fr; }
    .stay-panel { max-width: 100%; }
    .hotel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hotels-copy h1 { font-size: clamp(1.8rem, 5vw, 3rem); }
    .hotel-actions { flex-wrap: wrap; }
    .stay-map { height: 160px; }
  }
  /* ── Large mobile (≤768px) ── */
  @media (max-width: 768px) {
    .hotels-hero { padding: 110px 1.5rem 3rem; }
    .hotel-browser { padding: 2rem 1.5rem 4rem; }
    .browser-head { grid-template-columns: 1fr; gap: 0.75rem; }
    .hotel-select-filters { gap: 0.5rem; }
    .hotel-select-filters label { min-width: calc(50% - 0.25rem); flex: 1 1 calc(50% - 0.25rem); }
    .hotel-select-filters select { width: 100%; }
    .stay-stats { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  }
  /* ── Mobile (≤680px) ── */
  @media (max-width: 680px) {
    .hotels-hero { padding: 100px 1.25rem 2.5rem; }
    .hotel-browser { padding: 1.75rem 1.25rem 3.5rem; }
    .browser-head, .hotel-grid { grid-template-columns: 1fr; }
    .hotel-data-prompt { align-items: flex-start; flex-direction: column; }
    .stay-stats { grid-template-columns: 1fr; }
    .hotel-select-filters label { min-width: 100%; flex: 1 1 100%; }
    .stay-card { min-height: unset; }
  }
  /* ── Small mobile (≤420px) ── */
  @media (max-width: 420px) {
    .hotels-hero { padding: 90px 1rem 2rem; }
    .hotel-browser { padding: 1.5rem 1rem 3rem; }
    .district-filter { gap: 0.35rem; }
    .district-chip { font-size: 0.75rem; padding: 0.28rem 0.55rem; }
    .stay-card-link { padding: 0.85rem; }
    .hotel-actions { flex-direction: column; }
    .hotel-primary, .hotel-secondary { width: 100%; justify-content: center; }
    .hotel-page-btn { width: 2.4rem; }
  }
</style>

<script define:vars={{ showing: copy.showing, featuredHotel: copy.featuredHotel, featuredHotels: copy.featuredHotels }}>
  const PAGE = 30;
  const input = document.getElementById('hotel-search-input');
  const priceFilter = document.getElementById('hotel-price-filter');
  const count = document.getElementById('hotel-count');
  const cards = Array.from(document.querySelectorAll('.stay-card'));
  const chips = Array.from(document.querySelectorAll('.district-chip'));
  const paginationRow = document.getElementById('hotelPaginationRow');
  const prevBtn = document.getElementById('hotelPrevBtn');
  const nextBtn = document.getElementById('hotelNextBtn');
  const pageInfo = document.getElementById('hotelPageInfo');
  let activeDistrict = 'all';
  let hotelPage = 1;

  function normalize(value) {
    return value.toLowerCase().replace(/\s+/g, '');
  }

  function hasActiveFilter() {
    return (input?.value || '').trim() !== '' ||
      (priceFilter?.value || 'all') !== 'all' ||
      activeDistrict !== 'all';
  }

  function applyFilters() {
    const query = normalize(input?.value || '');
    const priceMode = priceFilter?.value || 'all';
    const filtering = hasActiveFilter();

    if (filtering) {
      let visible = 0;
      cards.forEach((card) => {
        const low = Number(card.dataset.priceLow || 0);
        const high = Number(card.dataset.priceHigh || 0);
        const priceKnown = card.dataset.priceKnown === 'true';
        const priceReference = low || high || 0;
        const passes =
          (activeDistrict === 'all' || card.dataset.district === activeDistrict) &&
          (!query || normalize(card.dataset.search || '').includes(query)) &&
          (priceMode === 'all' || (priceMode === 'unknown' && !priceKnown) ||
           (priceMode === 'budget' && priceKnown && priceReference > 0 && priceReference < 3000) ||
           (priceMode === 'mid' && priceKnown && priceReference >= 3000 && priceReference < 8000) ||
           (priceMode === 'premium' && priceKnown && priceReference >= 8000)) &&
          true;
        card.classList.toggle('is-hidden', !passes);
        if (passes) visible++;
      });
      if (count) count.textContent = `${showing} ${visible} ${visible === 1 ? featuredHotel : featuredHotels}`;
      if (paginationRow) paginationRow.style.display = 'none';
    } else {
      const total = cards.length;
      const totalPages = Math.ceil(total / PAGE);
      hotelPage = Math.max(1, Math.min(hotelPage, totalPages));
      const start = (hotelPage - 1) * PAGE;
      const end = start + PAGE;
      cards.forEach((card, i) => card.classList.toggle('is-hidden', i < start || i >= end));
      if (count) count.textContent = `${showing} ${total} ${total === 1 ? featuredHotel : featuredHotels}`;
      if (pageInfo) pageInfo.textContent = `${hotelPage} / ${totalPages}`;
      if (prevBtn) prevBtn.disabled = hotelPage === 1;
      if (nextBtn) nextBtn.disabled = hotelPage === totalPages;
      if (paginationRow) paginationRow.style.display = total > PAGE ? '' : 'none';
    }
  }

  prevBtn?.addEventListener('click', () => { if (hotelPage > 1) { hotelPage--; applyFilters(); document.querySelector('.hotel-browser')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); } });
  nextBtn?.addEventListener('click', () => { const tp = Math.ceil(cards.length / PAGE); if (hotelPage < tp) { hotelPage++; applyFilters(); document.querySelector('.hotel-browser')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); } });
  input?.addEventListener('input', () => { hotelPage = 1; applyFilters(); });
  priceFilter?.addEventListener('change', () => { hotelPage = 1; applyFilters(); });
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeDistrict = chip.dataset.district || 'all';
      chips.forEach((item) => item.classList.toggle('is-active', item === chip));
      hotelPage = 1;
      applyFilters();
    });
  });

  applyFilters();
</script>
