  .hotel-data-actions a { display: inline-flex; align-items: center; min-height: 34px; border: 1px solid rgba(255,255,255,0.28); border-radius: 999px; color: #fff; padding: 0.25rem 0.7rem; text-decoration: none; font-size: 0.8rem; font-weight: 900; }
  .hotel-data-actions a:hover { background: rgba(255,255,255,0.12); }
