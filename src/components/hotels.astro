  .hotel-data-prompt strong { display: block; color: #f5c15c; font-size: 0.9rem; margin-bottom: 0.15rem; }
  .hotel-data-prompt span { display: block; color: rgba(255,255,255,0.82); font-size: 0.82rem; line-height: 1.45; }
