---
import Layout from '../../../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

type Restaurant = {
  suggestion_level: number;
  name: string;
  photo: string;
  district: string;
  opening_hours: string[];
  categories: string[];
  avg_price: number;
  rating: number;
  blog_link: string;
  google_map: string;
  ifoodie_link?: string;
  lat?: number | null;
  lng?: number | null;
  address?: string;
  ai_intro?: string;
  ai_short?: string;
};

export async function getStaticPaths() {
  const raw = fs.readFileSync(path.resolve('./public/data/restaurants.json'), 'utf8');
  const data = JSON.parse(raw) as Restaurant[];
  return data.map((r, i) => ({
    params: { id: String(i) },
    props: { restaurant: r, idx: i },
  }));
}

interface Props { restaurant: Restaurant; idx: number }
const { restaurant, idx } = Astro.props as Props;
const backHref = Astro.url.searchParams.get('from') === 'ai' ? '/kr/ai' : '/kr/';

const cleanedHours = restaurant.opening_hours?.map((h) => h.replace(/^[\*\s]+/, '')) ?? [];

const priceTier =
  restaurant.avg_price >= 1500 ? '$$$$' :
  restaurant.avg_price >= 800 ? '$$$' :
  restaurant.avg_price >= 400 ? '$$' : '$';

const WEEK_LABELS = ['星期一', '星期二', '星期三', '星期四', '星期五', '星期六', '星期日'];
const WEEK_LABELS_KO = ['월요일', '화요일', '수요일', '목요일', '금요일', '토요일', '일요일'];
const today = (new Date().getDay() + 6) % 7;
function translateDay(h: string, labels: string[]): string {
  const idx = WEEK_LABELS.findIndex(label => h.startsWith(label));
  return idx >= 0 ? labels[idx] + h.slice(WEEK_LABELS[idx].length) : h;
}
const translatedHours = cleanedHours.map(h => translateDay(h, WEEK_LABELS_KO));
const todayRaw = cleanedHours.find((h) => h.startsWith(WEEK_LABELS[today])) ?? cleanedHours[0] ?? '—';
const todayHours = translateDay(todayRaw, WEEK_LABELS_KO);

const CATEGORY_KR: Record<string, string> = {
  '義式料理':'이탈리안','午餐':'점심','晚餐':'저녁','約會餐廳':'데이트 식당','早餐':'아침식사',
  '早午餐':'브런치','下午茶':'애프터눈티','甜點':'디저트','咖啡':'카페','精品咖啡':'스페셜티 커피',
  '居酒屋':'이자카야','和風洋食':'일본식 양식','日本料理':'일본 요리','拉麵':'라멘','壽司':'초밥',
  '燒肉':'야키니쿠','火鍋':'훠궈','涮涮鍋':'샤부샤부','韓式料理':'한식','韓式':'한국식',
  '泰式料理':'태국 요리','越式料理':'베트남 요리','印度料理':'인도 요리','法式料理':'프랑스 요리','美式料理':'미국 요리',
  '墨西哥料理':'멕시코 요리','西班牙料理':'스페인 요리','港式料理':'광둥 요리','廣東菜':'광둥 요리','中式料理':'중국 요리',
  '客家料理':'하카 요리','海鮮':'해산물','牛排':'스테이크','牛肉麵':'쇠고기 면','麵食':'면 요리','餃子':'만두',
  '小吃':'길거리 음식','宵夜':'야식','景觀餐廳':'뷰 맛집','親子餐廳':'가족 식당',
  '寵物友善':'펫 프렌들리','吃到飽':'무한리필','素食':'채식','合菜':'연회 요리','熱炒':'볶음 요리',
  '鐵板燒':'철판구이','攤販':'노점','餐盒':'도시락','速食餐廳':'패스트푸드','外帶外送店家':'포장/배달',
  '烘焙坊':'베이커리','蛋糕':'케이크','冰品飲料':'냉음료','冰淇淋':'아이스크림','刨冰':'빙수',
  '果汁吧':'주스바','飲料店':'음료 가게','茶店':'차 가게','啤酒':'맥주','啤酒吧':'맥주 바','酒吧':'바',
  '餐酒館':'비스트로','亞洲融合':'아시안 퓨전','異國料理':'이국 요리','新加坡料理':'싱가포르 요리',
  '馬來西亞料理':'말레이시아 요리','披薩':'피자','漢堡':'버거','咖哩':'카레','雞料理':'치킨 요리',
  '精緻高級':'파인다이닝','新開幕':'신규 오픈','食品專賣店':'전문점','輕食':'가벼운 식사',
  'Buffet':'뷔페','Fine Dining':'파인다이닝','POKE':'포케','TAPAS':'타파스',
};
const translateCat = (c: string) => CATEGORY_KR[c] ?? c;
---

<Layout title={`${restaurant.name} | Taipei Compass`}>
  <main class="place-page">
    <div class="place-nav">
      <a href={backHref} class="back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        뒤로
      </a>
    </div>

    <section class="place-hero restaurant-hero">
      {restaurant.photo && (
        <img class="hero-bg" src={restaurant.photo} alt={restaurant.name} loading="eager" />
      )}
      <div class="hero-scrim"></div>
      <div class="place-hero-inner">
        <div class="place-kind">
          <span class="material-symbols-outlined" style="font-size:16px;vertical-align:-3px">restaurant</span>
          레스토랑 · {restaurant.district}
        </div>
        <h1 class="place-h1">{restaurant.name}</h1>
        <div class="place-chips">
          {restaurant.rating > 0 && (
            <span class="place-chip rating">
              <span class="material-symbols-outlined" style="font-size:16px;vertical-align:-3px">star</span>
              {restaurant.rating.toFixed(1)}
            </span>
          )}
          {restaurant.avg_price > 0 && (
            <span class="place-chip">NT${restaurant.avg_price} · {priceTier}</span>
          )}
          {restaurant.categories?.slice(0, 4).map((c) => (
            <span class="place-chip ghost">{translateCat(c)}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="place-body">
      <div class="place-grid">
        <article class="place-about">
          <h2>이번 주 영업시간</h2>
          <div class="hours-today">
            <span class="material-symbols-outlined">schedule</span>
            <div>
              <div class="hours-label">오늘</div>
              <div class="hours-value">{todayHours}</div>
            </div>
          </div>
          <ul class="hours-list">
            {translatedHours.map((h, i) => (
              <li class:list={[{ active: i === today }]}>{h}</li>
            ))}
          </ul>

          {restaurant.categories?.length > 0 && (
            <>
              <h2 style="margin-top:2rem">태그</h2>
              <div class="place-chips" style="margin-top:0.5rem">
                {restaurant.categories.map((c) => (
                  <span class="place-chip outline">{translateCat(c)}</span>
                ))}
              </div>
            </>
          )}
        </article>

        <aside class="place-meta">
          <div class="meta-card">
            <div class="meta-row">
              <span class="material-symbols-outlined">location_on</span>
              <div>
                <div class="meta-label">지역</div>
                <div class="meta-value">{restaurant.district || '—'}</div>
              </div>
            </div>
            {restaurant.rating > 0 && (
              <div class="meta-row">
                <span class="material-symbols-outlined">star_rate</span>
                <div>
                  <div class="meta-label">평점</div>
                  <div class="meta-value">{restaurant.rating.toFixed(1)} / 5</div>
                </div>
              </div>
            )}
            {restaurant.avg_price > 0 && (
              <div class="meta-row">
                <span class="material-symbols-outlined">payments</span>
                <div>
                  <div class="meta-label">평균 가격</div>
                  <div class="meta-value">NT${restaurant.avg_price}</div>
                </div>
              </div>
            )}
            <a class="meta-cta" href={restaurant.google_map} target="_blank" rel="noopener">
              <span class="material-symbols-outlined">directions</span>
              Google 지도에서 열기
            </a>
            {restaurant.blog_link && (
              <a class="meta-cta ghost" href={restaurant.blog_link} target="_blank" rel="noopener" style="margin-top:0.5rem">
                <span class="material-symbols-outlined">menu_book</span>
                리뷰 읽기
              </a>
            )}
            {restaurant.ifoodie_link && (
              <a class="ifoodie-card" href={restaurant.ifoodie_link} target="_blank" rel="noopener">
                <img class="ifoodie-logo" src="/images/ifoodie-logo.png" alt="iFoodie" width="100" height="100" />
                <span>愛食記에서 보기</span>
              </a>
            )}
            <button
              class="meta-cta trip-toggle"
              id="add-to-trip"
              type="button"
              style="margin-top:0.5rem;background:transparent;border:1.5px solid var(--jade,#1E6B52);color:var(--jade,#1E6B52);cursor:pointer"
              data-id={String(idx)}
              data-type="r"
              data-name={restaurant.name}
              data-district={restaurant.district}
              data-image={restaurant.photo || ''}
              data-lat={String(restaurant.lat ?? '')}
              data-lng={String(restaurant.lng ?? '')}
              data-trip-href="/kr/trip"
            >
              <span class="material-symbols-outlined" id="trip-icon">bookmark_add</span>
              <span id="trip-label">일정에 추가</span>
            </button>
          </div>
        </aside>
      </div>
    </section>

    <meta data-place-id={`r:${idx}`} />
  </main>

  <style is:global>
    .place-page { background: var(--parchment, #FDF6E3); min-height: 100vh; padding: 96px 2rem 4rem; color: var(--ink, #1a1a2e); }
    .place-nav { max-width: 960px; margin: 0 auto 1rem; }
    .back-link { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--vermillion, #c0392b); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .back-link:hover { text-decoration: underline; }
    .back-link .material-symbols-outlined { font-size: 18px; }
    .place-hero { position: relative; max-width: 960px; margin: 0 auto; border-radius: 16px; overflow: hidden; color: #fff; padding: 3.5rem 2.5rem; min-height: 320px; display: flex; align-items: flex-end; }
    .restaurant-hero { background: #1a1a2e; }
    .place-hero .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; z-index: 0; }
    .place-hero .hero-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.45) 55%, rgba(0,0,0,0.1) 100%); z-index: 1; }
    .place-hero-inner { position: relative; z-index: 2; }
    .place-kind { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.9; margin-bottom: 0.5rem; }
    .place-h1 { font-family: 'Noto Serif TC', serif; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900; margin: 0.25rem 0 1rem; line-height: 1.1; }
    .place-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .place-chip { display: inline-flex; align-items: center; gap: 0.3rem; background: rgba(255,255,255,0.22); color: #fff; padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.82rem; backdrop-filter: blur(6px); }
    .place-chip.rating { background: #f59e0b; color: #1a1a2e; font-weight: 700; }
    .place-chip.ghost { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.3); }
    .place-chip.outline { background: #fff; color: var(--vermillion, #c0392b); border: 1px solid rgba(192,57,43,0.25); }
    .place-body { max-width: 960px; margin: 2rem auto 0; }
    .place-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
    .place-about h2 { font-family: 'Noto Serif TC', serif; font-size: 1.35rem; margin: 0 0 0.75rem; }
    .hours-today { display: flex; gap: 0.75rem; background: #fff; border: 1px solid rgba(192,57,43,0.15); border-left: 4px solid var(--vermillion, #c0392b); border-radius: 8px; padding: 0.9rem 1rem; margin-bottom: 1rem; }
    .hours-today .material-symbols-outlined { color: var(--vermillion, #c0392b); }
    .hours-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary, #666); }
    .hours-value { font-size: 1rem; margin-top: 0.1rem; font-weight: 500; }
    .hours-list { list-style: none; padding: 0; margin: 0 0 0.5rem; background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 8px; overflow: hidden; }
    .hours-list li { padding: 0.55rem 1rem; border-bottom: 1px dashed rgba(0,0,0,0.08); font-size: 0.92rem; }
    .hours-list li:last-child { border-bottom: none; }
    .hours-list li.active { background: rgba(192,57,43,0.05); font-weight: 600; }
    .meta-card { background: #fff; border: 1px solid rgba(192,57,43,0.12); border-radius: 12px; padding: 1.25rem; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
    .meta-row { display: flex; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px dashed rgba(0,0,0,0.08); }
    .meta-row:last-of-type { border-bottom: none; }
    .meta-row .material-symbols-outlined { color: var(--vermillion, #c0392b); font-size: 20px; margin-top: 0.15rem; }
    .meta-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary, #666); }
    .meta-value { font-size: 0.95rem; margin-top: 0.1rem; }
    .meta-cta { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; background: var(--vermillion, #c0392b); color: #fff; padding: 0.6rem 1rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; width: 100%; justify-content: center; box-sizing: border-box; }
    .meta-cta.ghost { background: transparent; color: var(--vermillion, #c0392b); border: 1px solid var(--vermillion, #c0392b); }
    .meta-cta:hover { filter: brightness(1.08); }
    .meta-cta .material-symbols-outlined { font-size: 18px; }
    .ifoodie-card { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-decoration: none; border: 1.5px solid rgba(192,57,43,0.18); border-radius: 12px; padding: 1rem; margin-top: 0.5rem; color: var(--vermillion); font-weight: 600; font-size: 0.9rem; transition: all 0.15s; }
    .ifoodie-card:hover { background: rgba(192,57,43,0.05); border-color: var(--vermillion); }
    .ifoodie-logo { width: 100px; height: 100px; border-radius: 20px; object-fit: cover; }
    .trip-toggle.saved {
      background: var(--jade, #1E6B52) !important;
      color: #fff !important;
      border-color: var(--jade, #1E6B52) !important;
    }
    @media (max-width: 768px) {
      .place-page { padding: 88px 1.25rem 3rem; }
      .place-hero { padding: 2.5rem 1.5rem; min-height: 260px; }
      .place-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    }
  </style>

  <script is:inline>
  (function () {
    const KEY = 'ytp_trip';
    const btn = document.getElementById('add-to-trip');
    if (!btn) return;

    const { id, type, name, district, image } = btn.dataset;

    function loadTrip() {
      try {
        const parsed = JSON.parse(localStorage.getItem(KEY) || '[]');
        if (Array.isArray(parsed)) return parsed;
        if (parsed && Array.isArray(parsed.places)) return parsed.places;
        return [];
      } catch {
        return [];
      }
    }
    function saveTrip(arr) { localStorage.setItem(KEY, JSON.stringify(arr)); }
    function isSaved() { return loadTrip().some(p => p.type === type && p.id === id); }

    function sync() {
      const saved = isSaved();
      btn.classList.toggle('saved', saved);
      document.getElementById('trip-icon').textContent = saved ? 'bookmark_remove' : 'bookmark_add';
      document.getElementById('trip-label').textContent = saved ? '일정에 저장됨 ✓' : '일정에 추가';
    }

    btn.addEventListener('click', () => {
      const trip = loadTrip();
      if (isSaved()) {
        saveTrip(trip.filter(p => !(p.type === type && p.id === id)));
      } else {
        const lat = btn.dataset.lat ? parseFloat(btn.dataset.lat) : null;
        const lng = btn.dataset.lng ? parseFloat(btn.dataset.lng) : null;
        trip.push({ id, type, name, district, lat, lng, image });
        saveTrip(trip);
        window.location.href = btn.dataset.tripHref || '/kr/trip';
      }
      sync();
    });

    sync();
  })();
  </script>
</Layout>
