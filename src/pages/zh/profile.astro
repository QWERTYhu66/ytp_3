---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="個人資料 | 台北指南針">
  <section class="hero" style="min-height: 100vh; display: flex; align-items: center; padding: 72px 2.5rem 0; background: var(--parchment);">
    <div class="content" style="max-width: 800px; margin: 0 auto; text-align: center; padding: 6rem 0;">
      <div class="section-label">帳戶</div>
      <h1 style="font-family: 'Noto Serif TC', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--ink); margin-bottom: 1.5rem;">個人資料</h1>
      <p style="font-size: 1.1rem; color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
        管理您的帳戶設定、儲存的行程和個人化推薦。
      </p>
      <a href="/zh" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--vermillion); color: #fff; padding: 0.9rem 2rem; border-radius: 4px; text-decoration: none; font-weight: 700;">
        返回首頁
      </a>
    </div>
  </section>
</Layout>
