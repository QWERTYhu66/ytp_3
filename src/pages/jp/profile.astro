---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="プロフィール | 台北コンパス">
  <section class="hero" style="min-height: 100vh; display: flex; align-items: center; padding: 72px 2.5rem 0; background: var(--parchment);">
    <div class="content" style="max-width: 800px; margin: 0 auto; text-align: center; padding: 6rem 0;">
      <div class="section-label">アカウント</div>
      <h1 style="font-family: 'Shippori Mincho', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: var(--ink); margin-bottom: 1.5rem;">プロフィール</h1>
      <p style="font-size: 1.1rem; color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
        アカウント設定、保存した旅行、パーソナライズされたレコメンデーションを管理。
      </p>
      <a href="/jp" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--vermillion); color: #fff; padding: 0.9rem 2rem; border-radius: 4px; text-decoration: none; font-weight: 700;">
        ホームに戻る
      </a>
    </div>
  </section>
</Layout>
