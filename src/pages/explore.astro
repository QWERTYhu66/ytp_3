---
import Layout from '../layouts/Layout.astro';
import attractionsRaw from '../../scripts/pages/attractions_en.json';
import festivalsRaw from '../data/festivals.json';
import fs from 'node:fs';
import path from 'node:path';

const attractionsData = attractionsRaw.filter((attraction: any) => Number(attraction.suggestion_level) === 3);
const districts = [...new Set(attractionsData.map((a: any) => a.district))].sort();
const categories = [...new Set(attractionsData.flatMap((a: any) => a.category))].sort();
const allTags = [...new Set(attractionsData.flatMap((a: any) => a.tags || []))].sort();
const TAG_ICONS: Record<string, string> = {
  'Indoor': 'weekend', 'Outdoor': 'forest', 'Daytime': 'wb_sunny',
  'Night': 'nightlight', 'Elders Are Friendly': 'elderly', 'Parent-Child Friendly': 'child_care',
  'Parity': 'attach_money', 'High Price': 'diamond',
};

type Festival = { slug: string; months: number[]; date: { en: string; zh: string; jp: string; kr: string }; emoji: string; color: string; title: { en: string; zh: string; jp: string; kr: string }; description: { en: string; zh: string; jp: string; kr: string }; destinations: string[]; };
const festivals = festivalsRaw as Festival[];
const MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const colorHex: Record<string,string> = { vermillion:'#c0392b', jade:'#1e6b52', gold:'#d4a017', amber:'#b87822', coral:'#e26a6a', pink:'#c5337a', ink:'#1a1a2e' };

const _restRaw = JSON.parse(fs.readFileSync(path.resolve('./public/data/restaurants.json'), 'utf8')) as any[];
const topFoods = _restRaw
  .map((r: any, i: number) => ({ ...r, _idx: i }))
  .filter((r: any) => { const l = Number(r.suggestion_level); return l === 2 || l === 3; })
  .sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0));

const FOOD_CAT_EN: Record<string,string> = {
  '義式料理':'Italian','午餐':'Lunch','晚餐':'Dinner','約會餐廳':'Date Night','早餐':'Breakfast',
  '早午餐':'Brunch','下午茶':'Afternoon Tea','甜點':'Dessert','咖啡':'Coffee','精品咖啡':'Specialty Coffee',
  '居酒屋':'Izakaya','和風洋食':'Japanese Western','日本料理':'Japanese','拉麵':'Ramen','壽司':'Sushi',
  '燒肉':'Yakiniku','火鍋':'Hot Pot','涮涮鍋':'Shabu-Shabu','韓式料理':'Korean','韓式':'Korean Style',
  '泰式料理':'Thai','越式料理':'Vietnamese','印度料理':'Indian','法式料理':'French','美式料理':'American',
  '墨西哥料理':'Mexican','西班牙料理':'Spanish','港式料理':'Cantonese','廣東菜':'Cantonese','中式料理':'Chinese',
  '客家料理':'Hakka','海鮮':'Seafood','牛排':'Steak','牛肉麵':'Beef Noodle','麵食':'Noodles','餃子':'Dumplings',
  '小吃':'Street Food','宵夜':'Late Night','景觀餐廳':'Scenic Dining','親子餐廳':'Family Friendly',
  '寵物友善':'Pet-Friendly','吃到飽':'All-You-Can-Eat','素食':'Vegetarian','合菜':'Banquet','熱炒':'Stir-fry',
  '鐵板燒':'Teppanyaki','攤販':'Food Stall','餐盒':'Bento','速食餐廳':'Fast Food','外帶外送店家':'Takeout',
  '烘焙坊':'Bakery','蛋糕':'Cake','冰品飲料':'Iced Drinks','冰淇淋':'Ice Cream','刨冰':'Shaved Ice',
  '果汁吧':'Juice Bar','飲料店':'Drinks','茶店':'Tea Shop','啤酒':'Beer','啤酒吧':'Beer Bar','酒吧':'Bar',
  '餐酒館':'Bistro','亞洲融合':'Asian Fusion','異國料理':'International','新加坡料理':'Singaporean',
  '馬來西亞料理':'Malaysian','披薩':'Pizza','漢堡':'Burger','咖哩':'Curry','雞料理':'Chicken',
  '精緻高級':'Fine Dining','新開幕':'Newly Opened','食品專賣店':'Specialty Shop','輕食':'Light Bites',
  'Buffet':'Buffet','Fine Dining':'Fine Dining','POKE':'Poke','TAPAS':'Tapas',
};
const foodCat = (c: string) => FOOD_CAT_EN[c] ?? c;

const DISTRICT_EN: Record<string,string> = {
  '三重區':'Sanchong District','中壢區':'Zhongli District','中山區':'Zhongshan District',
  '中正區':'Zhongzheng District','信义区':'Xinyi District','信義區':'Xinyi District',
  '內湖區':'Neihu District','内湖区':'Neihu District','北投區':'Beitou District',
  '南港區':'Nangang District','台北市':'Taipei City','士林區':'Shilin District',
  '大同區':'Datong District','大安区':"Da'an District",'大安區':"Da'an District",
  '文山區':'Wenshan District','新店區':'Xindian District','松山區':'Songshan District',
  '松山鎮':'Songshan','永和區':'Yonghe District','萬華區':'Wanhua District',
};
const districtLabel = (d: string) => DISTRICT_EN[d] ?? d;

const copy = {
  pageLabel: 'All Attractions',
  title: 'Explore Taipei',
  subtitle: 'Browse 800+ attractions, 8000+ restaurants, and countless festivals in Taipei. Filter by district, category, or search by name.',
  searchPlaceholder: 'Search attractions…',
  districtPlaceholder: 'Select districts',
  categoryPlaceholder: 'Select categories',
  noResults: 'No attractions match your filters.',
  clearFilters: 'Clear filters',
  results: 'results',
  showMore: 'Show more',
  showLess: 'Show less',
  tabAttractions: 'Attractions',
  tabFood: 'Food',
  tabFestivals: 'Festivals',
  foodSearchPlaceholder: 'Search restaurants…',
  foodDistrictPlaceholder: 'Select districts',
  foodCategoryPlaceholder: 'Select categories',
  foodClearFilters: 'Clear filters',
  foodNoResults: 'No restaurants match your filters.',
};

const foodDistricts = [...new Set(topFoods.map((r: any) => r.district).filter(Boolean))].sort();
const foodCategories = [...new Set(topFoods.flatMap((r: any) => (r.categories || []).map((c: string) => foodCat(c))))].sort();

function getFoodTags(r: any): string[] {
  const t: string[] = [];
  const cats: string[] = r.categories || [];
  const p = r.avg_price || 0;
  if (p > 0 && p <= 300) t.push('Budget');
  else if (p > 300 && p <= 800) t.push('Mid-Range');
  else if (p > 800) t.push('Upscale');
  if (cats.includes('約會餐廳')) t.push('Date Night');
  if (cats.includes('宵夜')) t.push('Late Night');
  if (cats.includes('早餐') || cats.includes('早午餐')) t.push('Breakfast & Brunch');
  if (cats.includes('下午茶')) t.push('Afternoon Tea');
  if (cats.includes('吃到飽') || cats.includes('Buffet')) t.push('Buffet');
  if (cats.includes('親子餐廳')) t.push('Family Friendly');
  if (cats.includes('寵物友善')) t.push('Pet-Friendly');
  if (cats.includes('精緻高級') || cats.includes('Fine Dining')) t.push('Fine Dining');
  if (cats.includes('素食')) t.push('Vegetarian');
  if (cats.includes('景觀餐廳')) t.push('Scenic View');
  if (cats.includes('酒吧') || cats.includes('啤酒吧') || cats.includes('居酒屋')) t.push('Bar & Drinks');
  return t;
}

const FOOD_TAG_ICONS: Record<string, string> = {
  'Budget': 'savings', 'Mid-Range': 'payments', 'Upscale': 'diamond',
  'Date Night': 'favorite', 'Late Night': 'nightlight', 'Breakfast & Brunch': 'wb_sunny',
  'Afternoon Tea': 'emoji_food_beverage', 'Buffet': 'restaurant_menu',
  'Family Friendly': 'child_care', 'Pet-Friendly': 'pets',
  'Fine Dining': 'stars', 'Vegetarian': 'eco', 'Scenic View': 'landscape', 'Bar & Drinks': 'local_bar',
};
const allFoodTags = [...new Set(topFoods.flatMap((r: any) => getFoodTags(r)))];
// Preserve logical order
const FOOD_TAG_ORDER = ['Budget','Mid-Range','Upscale','Date Night','Late Night','Breakfast & Brunch','Afternoon Tea','Buffet','Fine Dining','Vegetarian','Family Friendly','Pet-Friendly','Scenic View','Bar & Drinks'];
allFoodTags.sort((a, b) => FOOD_TAG_ORDER.indexOf(a) - FOOD_TAG_ORDER.indexOf(b));
---

<Layout title="Explore Taipei | Taipei Compass">
  <main class="explore-page">
    <div class="explore-head">
      <span class="section-label">{copy.pageLabel}</span>
      <h1>{copy.title}</h1>
      <p class="explore-sub">{copy.subtitle}</p>
    </div>

    <div class="explore-tabs">
      <button class="explore-tab active" id="tabAttractions" data-tab="attractions">
        <span class="material-symbols-outlined">location_on</span>
        {copy.tabAttractions}
      </button>
      <button class="explore-tab" id="tabFood" data-tab="food">
        <span class="material-symbols-outlined">restaurant</span>
        {copy.tabFood}
      </button>
      <button class="explore-tab" id="tabFestivals" data-tab="festivals">
        <span class="material-symbols-outlined">celebration</span>
        {copy.tabFestivals}
      </button>
    </div>

    <div id="panelAttractions">
      <div class="filter-bar" id="filterBar">
        <input type="search" id="searchInput" class="search-input" placeholder={copy.searchPlaceholder} autocomplete="off" spellcheck="false" />
        <select id="districtFilter" class="filter-select">
          <option value="" disabled selected>{copy.districtPlaceholder}</option>
          {districts.map((d: string) => <option value={d}>{d}</option>)}
        </select>
        <select id="categoryFilter" class="filter-select">
          <option value="" disabled selected>{copy.categoryPlaceholder}</option>
          {categories.map((c: string) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="tag-pills-row" id="tagPillsRow">
        {allTags.map((tag: string) => (
          <button class="tag-pill" data-tag={tag} type="button">
            <span class="material-symbols-outlined">{TAG_ICONS[tag] ?? 'label'}</span>
            {tag}
          </button>
        ))}
      </div>
      <div class="active-filters-row" id="activeFiltersRow" style="display:none">
        <div class="active-chips" id="allActiveChips"></div>
        <button id="clearBtn" class="clear-btn">{copy.clearFilters}</button>
      </div>
      <div class="results-bar"><span id="resultsCount" class="results-count"></span></div>
      <div class="attractions-grid" id="attractionsGrid">
        {attractionsData.map((a: any) => (
          <a href={`/place/a/${a.id}`} class="attraction-card" data-district={a.district} data-categories={a.category.join('|')} data-name={a.name.toLowerCase()} data-tags={(a.tags||[]).join('|')}>
            <div class="card-img-wrap">
              {a.image ? <img src={a.image} alt={a.name} loading="lazy" decoding="async" /> : <div class="card-img-placeholder"><span class="material-symbols-outlined">landscape</span></div>}
              <div class="card-cats">{a.category.map((c: string) => <span class="cat-pill">{c}</span>)}</div>
            </div>
            <div class="card-body">
              <h3 class="card-name">{a.name}</h3>
              <div class="card-meta">
                <span class="card-district"><span class="material-symbols-outlined">location_on</span>{a.district}</span>
                {a.nearby_mrt && <span class="card-mrt"><span class="material-symbols-outlined">train</span>{a.nearby_mrt}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="expand-row" id="expandRow">
        <button class="expand-btn" id="expandBtn">
          <span id="expandLabel">{copy.showMore}</span>
          <span class="material-symbols-outlined" id="expandIcon">expand_more</span>
        </button>
      </div>
      <div id="noResults" class="no-results" style="display:none">
        <span class="material-symbols-outlined">search_off</span>
        <p>{copy.noResults}</p>
        <button id="noResultsClear" class="clear-btn">{copy.clearFilters}</button>
      </div>
    </div>

    <div id="panelFood" style="display:none">
      <div class="filter-bar">
        <input type="search" id="foodSearch" class="search-input" placeholder={copy.foodSearchPlaceholder} autocomplete="off" spellcheck="false" />
        <select id="foodDistrict" class="filter-select">
          <option value="" disabled selected>{copy.foodDistrictPlaceholder}</option>
          {foodDistricts.map((d: string) => <option value={d}>{districtLabel(d)}</option>)}
        </select>
        <select id="foodCategory" class="filter-select">
          <option value="" disabled selected>{copy.foodCategoryPlaceholder}</option>
          {foodCategories.map((c: string) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="tag-pills-row" id="foodTagPillsRow">
        {allFoodTags.map((tag: string) => (
          <button class="tag-pill food-tag-pill" data-tag={tag} type="button">
            <span class="material-symbols-outlined">{FOOD_TAG_ICONS[tag] ?? 'label'}</span>
            {tag}
          </button>
        ))}
      </div>
      <div class="active-filters-row" id="foodActiveFiltersRow" style="display:none">
        <div class="active-chips" id="foodActiveChips"></div>
        <button id="foodClearBtn" class="clear-btn">{copy.foodClearFilters}</button>
      </div>
      <div class="results-bar"><span id="foodResultsCount" class="results-count"></span></div>
      <div class="attractions-grid" id="foodGrid">
        {topFoods.map((r: any) => (
          <a href={`/place/r/${r._idx}`} class="attraction-card food-card" data-district={r.district} data-categories={(r.categories || []).map((c: string) => foodCat(c)).join('|')} data-name={r.name.toLowerCase()} data-tags={getFoodTags(r).join('|')}>
            <div class="card-img-wrap">
              {r.photo ? <img src={r.photo} alt={r.name} loading="lazy" decoding="async" /> : <div class="card-img-placeholder"><span class="material-symbols-outlined">restaurant</span></div>}
              <div class="card-cats">{(r.categories || []).slice(0, 3).map((c: string) => <span class="cat-pill">{foodCat(c)}</span>)}</div>
              {r.rating > 0 && <div class="food-rating"><span class="material-symbols-outlined" style="font-size:12px">star</span>{r.rating.toFixed(1)}</div>}
            </div>
            <div class="card-body">
              <h3 class="card-name">{r.name}</h3>
              <div class="card-meta">
                <span class="card-district"><span class="material-symbols-outlined">location_on</span>{districtLabel(r.district)}</span>
                {r.avg_price > 0 && <span class="card-mrt"><span class="material-symbols-outlined">payments</span>NT${r.avg_price}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="expand-row" id="foodExpandRow">
        <button class="expand-btn" id="foodExpandBtn">
          <span id="foodExpandLabel">{copy.showMore}</span>
          <span class="material-symbols-outlined" id="foodExpandIcon">expand_more</span>
        </button>
      </div>
      <div id="foodNoResults" class="no-results" style="display:none">
        <span class="material-symbols-outlined">search_off</span>
        <p>{copy.foodNoResults}</p>
        <button id="foodNoClear" class="clear-btn">{copy.foodClearFilters}</button>
      </div>
    </div>

    <div id="panelFestivals" style="display:none">
      <div class="fest-grid">
        {festivals.map((f) => (
          <a href={`/festivals/${f.slug}`} class="fest-card" style={`--fest-color:${colorHex[f.color] ?? '#c0392b'}`}>
            <div class="fest-emoji">{f.emoji}</div>
            <div class="fest-body">
              <div class="fest-months">{f.months.map((m) => MONTH_NAMES[m - 1]).join(' · ')}</div>
              <h3 class="fest-title">{f.title.en}</h3>
              <p class="fest-desc">{f.description.en}</p>
            </div>
            <span class="material-symbols-outlined fest-arrow">chevron_right</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .explore-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #FEFAF4 0%, #F5ECD7 25%, #FDF6E3 100%);
    padding-top: 80px;
    padding-bottom: 4rem;
  }
  .explore-head { text-align: center; padding: 2rem 1.5rem 1.5rem; }
  .explore-head h1 { font-family: 'Noto Serif TC', serif; font-size: clamp(1.8rem, 4vw, 2.6rem); color: #1a1a2e; margin: 0.35rem 0 0.5rem; }
  .explore-sub { color: rgba(26,26,46,0.6); font-size: 0.95rem; max-width: 520px; margin: 0 auto; }

  .explore-tabs { display: flex; gap: 0.5rem; justify-content: center; padding: 0 1.5rem 1rem; max-width: 1100px; margin: 0 auto; }
  .explore-tab { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.3rem; border: 1.5px solid rgba(192,57,43,0.2); border-radius: 999px; background: transparent; color: rgba(26,26,46,0.5); font: 600 0.88rem 'Noto Sans TC', sans-serif; cursor: pointer; transition: all 0.18s; }
  .explore-tab .material-symbols-outlined { font-size: 17px; }
  .explore-tab.active { background: var(--vermillion); color: #fff; border-color: var(--vermillion); }
  .explore-tab:not(.active):hover { border-color: var(--vermillion); color: var(--vermillion); }

  .filter-bar { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; max-width: 1100px; margin: 0 auto 0.75rem; padding: 0 1.5rem; }
  .search-input { flex: 1; min-width: 180px; padding: 0.6rem 1rem; border: 1.5px solid rgba(192,57,43,0.18); border-radius: 999px; font: 0.9rem 'Noto Sans TC', sans-serif; background: #fff; color: var(--ink); outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
  .search-input:focus { border-color: rgba(192,57,43,0.45); box-shadow: 0 0 0 3px rgba(192,57,43,0.08); }
  .search-input::placeholder { color: rgba(26,26,46,0.35); }
  .filter-select {
    padding: 0.6rem 2.2rem 0.6rem 1rem;
    border: 1.5px solid rgba(192,57,43,0.18);
    border-radius: 999px;
    font: 0.9rem 'Noto Sans TC', sans-serif;
    background-color: #fff;
    color: var(--ink);
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, rgba(26,26,46,0.5) 50%), linear-gradient(135deg, rgba(26,26,46,0.5) 50%, transparent 50%);
    background-position: calc(100% - 16px) calc(50% - 3px), calc(100% - 11px) calc(50% - 3px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }
  .filter-select:focus { border-color: rgba(192,57,43,0.45); }

  /* Tag toggle pills */
  .tag-pills-row { display: flex; flex-wrap: wrap; gap: 0.4rem; max-width: 1100px; margin: 0 auto 0.75rem; padding: 0 1.5rem; }
  .tag-pill { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.85rem; border: 1.5px solid rgba(192,57,43,0.18); border-radius: 999px; background: #fff; color: rgba(26,26,46,0.6); font: 600 0.8rem 'Noto Sans TC', sans-serif; cursor: pointer; transition: all 0.15s; }
  .tag-pill .material-symbols-outlined { font-size: 14px; }
  .tag-pill:hover { border-color: var(--vermillion); color: var(--vermillion); }
  .tag-pill.active { background: var(--vermillion); color: #fff; border-color: var(--vermillion); }

  /* Active filter chips row */
  .active-filters-row { display: flex; align-items: center; gap: 0.6rem; max-width: 1100px; margin: 0 auto 0.6rem; padding: 0 1.5rem; }
  .active-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; flex: 1; }
  .active-chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.28rem 0.5rem 0.28rem 0.75rem; border: 1px solid rgba(192,57,43,0.3); border-radius: 999px; background: rgba(192,57,43,0.08); color: var(--vermillion); font: 600 0.78rem 'Noto Sans TC', sans-serif; }
  .active-chip-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; border: none; background: rgba(192,57,43,0.15); color: var(--vermillion); cursor: pointer; font-size: 12px; line-height: 1; padding: 0; transition: background 0.12s; }
  .active-chip-x:hover { background: var(--vermillion); color: #fff; }

  .clear-btn { padding: 0.45rem 1rem; background: transparent; border: 1.5px solid rgba(192,57,43,0.3); border-radius: 999px; color: var(--vermillion); font: 600 0.82rem 'Noto Sans TC', sans-serif; cursor: pointer; transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
  .clear-btn:hover { background: var(--vermillion); color: #fff; border-color: var(--vermillion); }

  .results-bar { max-width: 1100px; margin: 0 auto 0.75rem; padding: 0 1.5rem; }
  .results-count { font-size: 0.82rem; color: rgba(26,26,46,0.5); font-weight: 600; }

  .attractions-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .attraction-card { background: #fff; border: 1px solid rgba(192,57,43,0.1); border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; box-shadow: 0 2px 10px rgba(26,26,46,0.05); transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease; }
  .attraction-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(192,57,43,0.13); border-color: rgba(192,57,43,0.28); }
  .attraction-card[data-hidden] { display: none; }

  .card-img-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #f0ebe0; }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .attraction-card:hover .card-img-wrap img { transform: scale(1.04); }
  .card-img-placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: rgba(192,57,43,0.25); }
  .card-img-placeholder .material-symbols-outlined { font-size: 2.5rem; }

  .card-cats { position: absolute; bottom: 0.5rem; left: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .cat-pill { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.18rem 0.55rem; background: rgba(26,26,46,0.62); color: #fff; border-radius: 999px; backdrop-filter: blur(4px); }

  .card-body { padding: 0.9rem 1rem; flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
  .card-name { font-size: 1rem; font-weight: 700; color: #1a1a2e; line-height: 1.3; margin: 0; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .card-district, .card-mrt { display: inline-flex; align-items: center; gap: 0.2rem; font-size: 0.77rem; color: rgba(26,26,46,0.55); }
  .card-district .material-symbols-outlined, .card-mrt .material-symbols-outlined { font-size: 13px; color: #c0392b; opacity: 0.7; }

  .food-rating { position: absolute; top: 0.5rem; right: 0.5rem; display: inline-flex; align-items: center; gap: 0.2rem; background: rgba(26,26,46,0.7); color: #fff; font-size: 0.72rem; font-weight: 700; padding: 0.18rem 0.5rem; border-radius: 999px; backdrop-filter: blur(4px); }
  .food-rating .material-symbols-outlined { color: #f7c948; }

  .expand-row { display: flex; justify-content: center; padding: 1.5rem 0 0.5rem; max-width: 1100px; margin: 0 auto; }
  .expand-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.6rem; background: #fff; border: 1.5px solid rgba(192,57,43,0.25); border-radius: 999px; color: var(--vermillion); font: 600 0.9rem 'Noto Sans TC', sans-serif; cursor: pointer; transition: all 0.18s; }
  .expand-btn:hover { background: var(--vermillion); color: #fff; border-color: var(--vermillion); }
  .expand-btn .material-symbols-outlined { font-size: 18px; transition: transform 0.2s; }
  .expand-btn.expanded .material-symbols-outlined { transform: rotate(180deg); }

  .no-results { text-align: center; padding: 4rem 1rem; color: rgba(26,26,46,0.45); }
  .no-results .material-symbols-outlined { font-size: 3rem; display: block; margin-bottom: 0.75rem; }
  .no-results p { margin-bottom: 1.25rem; font-size: 1rem; }

  .fest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; max-width: 1100px; margin: 0.5rem auto 0; padding: 0 1.5rem; }
  .fest-card { display: flex; align-items: flex-start; gap: 1rem; background: #fff; border: 1.5px solid rgba(192,57,43,0.1); border-left: 4px solid var(--fest-color, #c0392b); border-radius: 14px; padding: 1.2rem; text-decoration: none; color: #1a1a2e; transition: transform 0.18s, box-shadow 0.18s; }
  .fest-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(26,26,46,0.08); }
  .fest-emoji { font-size: 2rem; flex-shrink: 0; line-height: 1; }
  .fest-body { flex: 1; }
  .fest-months { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fest-color, #c0392b); margin-bottom: 0.25rem; }
  .fest-title { font-size: 1rem; font-weight: 700; margin: 0 0 0.35rem; line-height: 1.3; }
  .fest-desc { font-size: 0.8rem; color: rgba(26,26,46,0.55); line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fest-arrow { color: rgba(26,26,46,0.25); font-size: 20px; align-self: center; flex-shrink: 0; transition: transform 0.18s; }
  .fest-card:hover .fest-arrow { transform: translateX(3px); color: var(--fest-color, #c0392b); }

  @media (max-width: 600px) {
    .filter-bar { gap: 0.45rem; }
    .search-input { min-width: 100%; }
    .filter-select { flex: 1; }
    .attractions-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.85rem; }
    .card-name { font-size: 0.88rem; }
    .fest-grid { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ showMoreLabel: copy.showMore, showLessLabel: copy.showLess }}>
  const LIMIT = 9;
  const STEP = 9;
  const grid = document.getElementById('attractionsGrid');
  const noResults = document.getElementById('noResults');
  const noResultsClear = document.getElementById('noResultsClear');
  const searchInput = document.getElementById('searchInput');
  const districtFilter = document.getElementById('districtFilter');
  const districtSelections = document.getElementById('districtSelections');
  const categoryFilter = document.getElementById('categoryFilter');
  const categorySelections = document.getElementById('categorySelections');
  const clearBtn = document.getElementById('clearBtn');
  const resultsCount = document.getElementById('resultsCount');
  const expandRow = document.getElementById('expandRow');
  const expandBtn = document.getElementById('expandBtn');
  const expandLabel = document.getElementById('expandLabel');
  const expandIcon = document.getElementById('expandIcon');

  const cards = Array.from(grid.querySelectorAll('.attraction-card'));
  const total = cards.length;
  let visibleCount = LIMIT;
  const selectedDistricts = new Set();
  const selectedCategories = new Set();
  const selectedTags = new Set();

  const activeFiltersRow = document.getElementById('activeFiltersRow');
  const allActiveChips = document.getElementById('allActiveChips');

  function renderAllActiveChips() {
    if (!allActiveChips) return;
    const hasAny = selectedDistricts.size || selectedCategories.size || selectedTags.size;
    if (activeFiltersRow) activeFiltersRow.style.display = hasAny ? '' : 'none';
    if (!hasAny) { allActiveChips.innerHTML = ''; return; }

    const makeChip = (label, onRemove) =>
      `<span class="active-chip">${label}<button class="active-chip-x" type="button" data-label="${label}" aria-label="Remove ${label}">×</button></span>`;

    allActiveChips.innerHTML = [
      ...[...selectedDistricts].map(v => makeChip(v)),
      ...[...selectedCategories].map(v => makeChip(v)),
      ...[...selectedTags].map(v => makeChip(v)),
    ].join('');

    allActiveChips.querySelectorAll('.active-chip-x').forEach(btn => {
      btn.addEventListener('click', () => {
        const label = btn.dataset.label;
        selectedDistricts.delete(label);
        selectedCategories.delete(label);
        if (selectedTags.delete(label)) {
          // un-highlight the tag pill
          document.querySelectorAll(`.tag-pill[data-tag="${label}"]`).forEach(p => p.classList.remove('active'));
        }
        renderAllActiveChips();
        applyFilters();
      });
    });
  }

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    const hasFilter = query || selectedDistricts.size || selectedCategories.size || selectedTags.size;
    const limit = hasFilter ? Infinity : visibleCount;
    let visible = 0;
    for (const card of cards) {
      const nameMatch = !query || card.dataset.name.includes(query);
      const districtMatch = !selectedDistricts.size || selectedDistricts.has(card.dataset.district);
      const categoryMatch = !selectedCategories.size || card.dataset.categories.split('|').some(c => selectedCategories.has(c));
      const tagMatch = !selectedTags.size || card.dataset.tags.split('|').some(t => selectedTags.has(t));
      const passes = nameMatch && districtMatch && categoryMatch && tagMatch;
      const show = passes && visible < limit;
      card.toggleAttribute('data-hidden', !show);
      if (passes) visible++;
    }
    resultsCount.textContent = hasFilter ? `${visible} of ${total} results` : `${total} results`;
    noResults.style.display = visible === 0 ? '' : 'none';
    grid.style.display = visible === 0 ? 'none' : '';
    expandRow.style.display = (!hasFilter && total > LIMIT) ? '' : 'none';
  }

  function clearAll() {
    searchInput.value = '';
    districtFilter.value = '';
    categoryFilter.value = '';
    selectedDistricts.clear();
    selectedCategories.clear();
    selectedTags.clear();
    document.querySelectorAll('.tag-pill').forEach(p => p.classList.remove('active'));
    renderAllActiveChips();
    applyFilters();
  }

  expandBtn.addEventListener('click', () => {
    if (visibleCount < total) {
      visibleCount = Math.min(visibleCount + STEP, total);
    } else {
      visibleCount = LIMIT;
    }
    const fullyShown = visibleCount >= total;
    expandLabel.textContent = fullyShown ? showLessLabel : showMoreLabel;
    expandIcon.textContent = fullyShown ? 'expand_less' : 'expand_more';
    expandBtn.classList.toggle('expanded', fullyShown);
    applyFilters();
  });

  searchInput.addEventListener('input', applyFilters);

  districtFilter.addEventListener('change', () => {
    const value = districtFilter.value;
    if (value) { selectedDistricts.add(value); districtFilter.value = ''; renderAllActiveChips(); }
    applyFilters();
  });

  categoryFilter.addEventListener('change', () => {
    const value = categoryFilter.value;
    if (value) { selectedCategories.add(value); categoryFilter.value = ''; renderAllActiveChips(); }
    applyFilters();
  });

  document.querySelectorAll('.tag-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const tag = pill.dataset.tag;
      if (selectedTags.has(tag)) {
        selectedTags.delete(tag);
        pill.classList.remove('active');
      } else {
        selectedTags.add(tag);
        pill.classList.add('active');
      }
      renderAllActiveChips();
      applyFilters();
    });
  });

  clearBtn.addEventListener('click', clearAll);
  noResultsClear.addEventListener('click', clearAll);
  renderAllActiveChips();
  applyFilters();

  // Food filters
  const foodGrid = document.getElementById('foodGrid');
  const foodSearch = document.getElementById('foodSearch');
  const foodDistrict = document.getElementById('foodDistrict');
  const foodCategory = document.getElementById('foodCategory');
  const foodClearBtn = document.getElementById('foodClearBtn');
  const foodResultsCount = document.getElementById('foodResultsCount');
  const foodNoResults = document.getElementById('foodNoResults');
  const foodExpandRow = document.getElementById('foodExpandRow');
  const foodExpandBtn = document.getElementById('foodExpandBtn');
  const foodExpandLabel = document.getElementById('foodExpandLabel');
  const foodExpandIcon = document.getElementById('foodExpandIcon');
  const foodActiveFiltersRow = document.getElementById('foodActiveFiltersRow');
  const foodActiveChips = document.getElementById('foodActiveChips');
  const foodCards = foodGrid ? Array.from(foodGrid.querySelectorAll('.food-card')) : [];
  const foodTotal = foodCards.length;
  const FOOD_LIMIT = 24;
  const FOOD_STEP = 24;
  let foodVisible = FOOD_LIMIT;
  const selectedFoodDistricts = new Set();
  const selectedFoodCategories = new Set();
  const selectedFoodTags = new Set();

  function renderFoodActiveChips() {
    if (!foodActiveChips) return;
    const hasAny = selectedFoodDistricts.size || selectedFoodCategories.size || selectedFoodTags.size;
    if (foodActiveFiltersRow) foodActiveFiltersRow.style.display = hasAny ? '' : 'none';
    if (!hasAny) { foodActiveChips.innerHTML = ''; return; }
    const makeChip = (v) =>
      `<span class="active-chip">${v}<button class="active-chip-x" type="button" data-label="${v}" aria-label="Remove ${v}">×</button></span>`;
    foodActiveChips.innerHTML = [
      ...[...selectedFoodDistricts].map(makeChip),
      ...[...selectedFoodCategories].map(makeChip),
      ...[...selectedFoodTags].map(makeChip),
    ].join('');
    foodActiveChips.querySelectorAll('.active-chip-x').forEach(btn => {
      btn.addEventListener('click', () => {
        const label = btn.dataset.label;
        selectedFoodDistricts.delete(label);
        selectedFoodCategories.delete(label);
        if (selectedFoodTags.delete(label)) {
          document.querySelectorAll(`.food-tag-pill[data-tag="${label}"]`).forEach(p => p.classList.remove('active'));
        }
        renderFoodActiveChips();
        applyFoodFilters();
      });
    });
  }

  function applyFoodFilters() {
    const q = foodSearch ? foodSearch.value.trim().toLowerCase() : '';
    const hasFilter = q || selectedFoodDistricts.size || selectedFoodCategories.size || selectedFoodTags.size;
    const limit = hasFilter ? Infinity : foodVisible;
    let visible = 0;
    for (const card of foodCards) {
      const nameMatch = !q || card.dataset.name.includes(q);
      const districtMatch = !selectedFoodDistricts.size || selectedFoodDistricts.has(card.dataset.district);
      const catMatch = !selectedFoodCategories.size || card.dataset.categories.split('|').some(c => selectedFoodCategories.has(c));
      const tagMatch = !selectedFoodTags.size || (card.dataset.tags || '').split('|').some(t => selectedFoodTags.has(t));
      const passes = nameMatch && districtMatch && catMatch && tagMatch;
      const show = passes && visible < limit;
      card.toggleAttribute('data-hidden', !show);
      if (passes) visible++;
    }
    if (foodResultsCount) foodResultsCount.textContent = hasFilter ? `${visible} of ${foodTotal} restaurants` : `${foodTotal} restaurants`;
    if (foodNoResults) foodNoResults.style.display = visible === 0 ? '' : 'none';
    if (foodGrid) foodGrid.style.display = visible === 0 ? 'none' : '';
    if (foodExpandRow) foodExpandRow.style.display = (!hasFilter && foodTotal > FOOD_LIMIT) ? '' : 'none';
  }

  function clearFoodFilters() {
    if (foodSearch) foodSearch.value = '';
    if (foodDistrict) foodDistrict.value = '';
    if (foodCategory) foodCategory.value = '';
    selectedFoodDistricts.clear();
    selectedFoodCategories.clear();
    selectedFoodTags.clear();
    document.querySelectorAll('.food-tag-pill').forEach(p => p.classList.remove('active'));
    renderFoodActiveChips();
    applyFoodFilters();
  }
  if (foodSearch) {
    foodSearch.addEventListener('input', applyFoodFilters);
    foodDistrict.addEventListener('change', () => {
      const value = foodDistrict.value;
      if (value) { selectedFoodDistricts.add(value); foodDistrict.value = ''; renderFoodActiveChips(); }
      applyFoodFilters();
    });
    foodCategory.addEventListener('change', () => {
      const value = foodCategory.value;
      if (value) { selectedFoodCategories.add(value); foodCategory.value = ''; renderFoodActiveChips(); }
      applyFoodFilters();
    });
    foodClearBtn.addEventListener('click', clearFoodFilters);
    document.getElementById('foodNoClear')?.addEventListener('click', clearFoodFilters);
    document.querySelectorAll('.food-tag-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const tag = pill.dataset.tag;
        if (selectedFoodTags.has(tag)) {
          selectedFoodTags.delete(tag);
          pill.classList.remove('active');
        } else {
          selectedFoodTags.add(tag);
          pill.classList.add('active');
        }
        renderFoodActiveChips();
        applyFoodFilters();
      });
    });
    foodExpandBtn?.addEventListener('click', () => {
      if (foodVisible < foodTotal) {
        foodVisible = Math.min(foodVisible + FOOD_STEP, foodTotal);
      } else {
        foodVisible = FOOD_LIMIT;
      }
      const fullyShown = foodVisible >= foodTotal;
      foodExpandLabel.textContent = fullyShown ? showLessLabel : showMoreLabel;
      foodExpandIcon.textContent = fullyShown ? 'expand_less' : 'expand_more';
      foodExpandBtn.classList.toggle('expanded', fullyShown);
      applyFoodFilters();
    });
    applyFoodFilters();
  }

  document.querySelectorAll('.explore-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.explore-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.tab;
      document.getElementById('panelAttractions').style.display = tab === 'attractions' ? '' : 'none';
      document.getElementById('panelFood').style.display = tab === 'food' ? '' : 'none';
      document.getElementById('panelFestivals').style.display = tab === 'festivals' ? '' : 'none';
    });
  });

  (function syncFromPrefs() {
    let prefs;
    try {
      const raw = localStorage.getItem('ytp_prefs');
      if (!raw) return;
      prefs = JSON.parse(raw);
    } catch {
      return;
    }

    const prefDistricts = Array.isArray(prefs?.districts) ? prefs.districts : [];
    const prefInterests = Array.isArray(prefs?.interests) ? prefs.interests.map((v) => String(v).toLowerCase()) : [];
    if (!prefDistricts.length && !prefInterests.length) return;

    const districtAliases = {
      '大安區': ['大安區', "Da'an District", 'Daan District', '大安区', '다안구'],
      '信義區': ['信義區', 'Xinyi District', '信義区', '신이구'],
      '中山區': ['中山區', 'Zhongshan District', '中山区', '중산구'],
      '中正區': ['中正區', 'Zhongzheng District', '中正区', '중정구'],
      '松山區': ['松山區', 'Songshan District', '松山区', '송산구'],
      '士林區': ['士林區', 'Shilin District', '士林区', '스린구'],
      '大同區': ['大同區', 'Datong District', '大同区', '다퉁구'],
      '萬華區': ['萬華區', 'Wanhua District', '万華区', '완화구'],
      '內湖區': ['內湖區', 'Neihu District', '内湖区', '네이후구'],
      '北投區': ['北投區', 'Beitou District', '北投区', '베이터우구'],
      '文山區': ['文山區', 'Wenshan District', '文山区', '원산구'],
      '南港區': ['南港區', 'Nangang District', '南港区', '난강구'],
    };
    const canonDistrict = (d) => Object.keys(districtAliases).find((k) => districtAliases[k].includes(d)) || d;
    const selectedCanon = prefDistricts.map(canonDistrict);

    const addDistrictMatches = (selectEl, targetSet, applyFn) => {
      if (!selectEl) return;
      const values = Array.from(selectEl.options).map((o) => o.value).filter(Boolean);
      values.filter((v) => selectedCanon.includes(canonDistrict(v))).forEach((v) => targetSet.add(v));
    };

    addDistrictMatches(districtFilter, selectedDistricts, applyFilters);
    addDistrictMatches(document.getElementById('foodDistrict'), selectedFoodDistricts, applyFoodFilters);
    renderAllActiveChips();

    if (categoryFilter && prefInterests.length) {
      const aliases = {
        food: ['food', 'gourmet', '美食', 'グルメ', '맛있는 음식'],
        culture: ['culture', '文化', 'カルチャー', '문화'],
        nature: ['nature', '自然', '자연'],
        shopping: ['shopping', '購物', '買い物', 'ショッピング', '쇼핑'],
        relax: ['relax', 'leisure', '休閒', 'レジャー', '여가', '溫泉', '温泉', '온천'],
        night: ['night', '夜晚', '夜', 'ナイト', '밤', '나이트'],
      };
      const optionValues = Array.from(categoryFilter.options).map((o) => o.value).filter(Boolean);
      prefInterests
        .flatMap((interest) => aliases[interest] || [interest])
        .forEach((needle) => {
          const selected = optionValues.find((v) => String(v).toLowerCase().includes(String(needle).toLowerCase()));
          if (selected) selectedCategories.add(selected);
        });
      renderAllActiveChips();
    }

    const shouldOpenFood = prefInterests.includes('food') && !prefInterests.some((v) => ['culture', 'nature', 'shopping', 'relax', 'night'].includes(v));
    applyFilters();
    if (foodSearch) applyFoodFilters();
    if (shouldOpenFood) document.getElementById('tabFood')?.click();
  })();
</script>
